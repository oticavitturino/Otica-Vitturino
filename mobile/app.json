{
  "expo": {
    "name": "OticaVitturino",
    "slug": "OticaVitturino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/logovitturino.png",
    "scheme": "oticavitturino",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eeeded",
        "foregroundImage": "./assets/img/logovitturino.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "package": "com.danielprogram08.OticaVitturino"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/img/logovitturino.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/logovitturino.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#eeeded",
          "dark": {
            "backgroundColor": "#eeeded"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca9d8ae1-26a2-484e-aecd-4ca5ef74ab1e"
      }
    },
    "owner": "danielprogram08"
  }
}
