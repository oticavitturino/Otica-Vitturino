# APK / Expo Go em dispositivo físico: use o IP LAN do PC (porta 80 do nginx no docker-compose).
# O nginx encaminha /auth, /customer, /orders, /scheduling e /occurrences para o backend.
EXPO_PUBLIC_API_URL=http://192.168.0.110

# Se o IP da Ethernet mudar, atualize também eas.json e app.json extra.apiUrl.
